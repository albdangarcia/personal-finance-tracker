# Secret key for authentication
AUTH_SECRET = ""

# Trust host for authentication
AUTH_TRUST_HOST = "true"

# Local Docker (direct)
POSTGRES_URL=postgresql://your_user:your_password@postgres:5432/your_db

# Production - Neon + Vercel integration auto-injects these, you don't need to add them manually
# DATABASE_URL=postgresql://...pooler...?pgbouncer=true
# DATABASE_URL_UNPOOLED=postgresql://...direct...
# POSTGRES_URL_NON_POOLING=postgresql://...direct...

# For demo purposes only
NEXT_PUBLIC_IS_DEMO=false