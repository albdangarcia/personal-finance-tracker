# Secret key for authentication
AUTH_SECRET = ""

# Trust host for authentication
AUTH_TRUST_HOST = "true"

# Local development (host machine). docker-compose.yml uses the Docker service URL internally.
DATABASE_URL=postgresql://personal_finance:personal_finance_local_dev@localhost:5434/personal_finance_dev

# Optional direct connection for Prisma migrations when DATABASE_URL uses a pooler
# DATABASE_URL_UNPOOLED=postgresql://...direct...

# For demo purposes only
NEXT_PUBLIC_IS_DEMO=false
